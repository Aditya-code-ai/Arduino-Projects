//Project 23: Workng of PIR sensor

// Pin Definitions
#define pirSensorPin 3 // PIR motion sensor pin
#define ledPin 4       // LED pin

void setup() {
  // Initialize Serial Monitor
  Serial.begin(9600);

  // Configure Pins
  pinMode(pirSensorPin, INPUT); // PIR sensor as input
  pinMode(ledPin, OUTPUT);      // LED as output

  Serial.println("PIR Sensor Test Initialized");
}

void loop() {
  // Read the PIR sensor state
  bool motionDetected = digitalRead(pirSensorPin);

  if (motionDetected) {
    // Turn on LED if motion is detected
    digitalWrite(ledPin, HIGH);
    Serial.println("Motion Detected: LED ON");
  } else {
    // Turn off LED if no motion is detected
    digitalWrite(ledPin, LOW);
    Serial.println("No Motion: LED OFF");
  }

  delay(100); // Short delay for stability
}
