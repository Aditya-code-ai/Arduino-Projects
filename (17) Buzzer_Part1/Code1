// Pin connected to the buzzer
const int buzzerPin = 8; 

void setup() {
  // No setup required for tone
}

void loop() {
  // Play a 1kHz tone for 500ms
  tone(buzzerPin, 1000, 500); 
  delay(1000); // Wait for 1 second
  
  // Play a 500Hz tone for 300ms
  tone(buzzerPin, 500, 300);
  delay(1000); // Wait for 1 second
  
  // No tone for 1 second
  noTone(buzzerPin);
  delay(1000);
}
